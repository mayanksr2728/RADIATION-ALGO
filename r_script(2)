> create_pseudo_bulk_fixed <- function(eset) {
+     # Extract counts and metadata
+     counts <- exprs(eset)
+     metadata <- pData(eset)
+     
+     # Force access using backticks for the column with a colon
+     # We also ensure it's treated as a factor
+     group_col <- as.factor(metadata$`treatment:ch1`)
+     
+     # Aggregate using rowsum
+     pseudo_bulk_matrix <- rowsum(t(counts), group_col)
+     pseudo_bulk_matrix <- t(pseudo_bulk_matrix)
+     
+     # Log2 normalize if data appears to be raw counts (max > 50)
+     if(max(pseudo_bulk_matrix) > 50) {
+         log2_counts <- log2(pseudo_bulk_matrix + 1)
+     } else {
+         log2_counts <- pseudo_bulk_matrix
+     }
+     
+     # Create the new ExpressionSet
+     new_pData <- data.frame(
+         Condition = colnames(log2_counts),
+         row.names = colnames(log2_counts)
+     )
+     
+     return(ExpressionSet(assayData = log2_counts, 
+                          phenoData = AnnotatedDataFrame(new_pData)))
+ }
