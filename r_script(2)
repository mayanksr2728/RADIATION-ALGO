> # --- 2. THE CORE PROCESSING FUNCTION ---
> process_dataset <- function(file_path) {
+     # Load data into a safe environment
+     temp_env <- new.env()
+     load(file_path, envir = temp_env)
+     eset <- get(ls(temp_env)[1], envir = temp_env)
+     
+     # Sanitize metadata (Fixes the "No IR control" and space issues)
+     pData(eset)$Condition <- make.names(paste0("D", pData(eset)$Dose, "_T", pData(eset)$Time))
+     
+     # Create Design Matrix
+     design <- model.matrix(~0 + factor(pData(eset)$Condition))
+     colnames(design) <- levels(factor(pData(eset)$Condition))
+     
+     # Dynamic Contrasts: Compare all D3 (Irradiation) conditions vs D0_T0 (Control)
+     all_cols <- colnames(design)
+     ir_cols <- all_cols[grep("D3\\.", all_cols)]
+     contrast_strings <- paste0(ir_cols, " - D0.T0")
+     names(contrast_strings) <- paste0("vs_", ir_cols)
+     
+     contrast.matrix <- do.call(makeContrasts, c(as.list(contrast_strings), list(levels = design)))
+     
+     # Statistical Fit
+     fit <- lmFit(exprs(eset), design)
+     fit2 <- eBayes(contrasts.fit(fit, contrast.matrix))
+     
+     # Extract results for the 4 canonical probes
+     # We combine all contrasts into one topTable
+     all_res <- topTable(fit2, number = Inf)
+     signature_res <- all_res[rownames(all_res) %in% mouse_lookup$probe_id, ]
+     
+     # Add annotations
+     signature_res$probe_id <- rownames(signature_res)
+     signature_res <- merge(signature_res, mouse_lookup, by = "probe_id")
+     signature_res$dataset <- basename(file_path)
+     
+     return(signature_res)
+ }
