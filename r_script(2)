> create_pseudo_bulk_final <- function(eset) {
+     # 1. Extract and force to dense numeric matrix
+     # Using as.matrix() ensures it isn't a sparse matrix (e.g., from Matrix package)
+     counts <- as.matrix(exprs(eset))
+     
+     # 2. Ensure data is numeric (strips any non-numeric artifacts)
+     storage.mode(counts) <- "double"
+     
+     # 3. Extract metadata with backticks
+     metadata <- pData(eset)
+     group_col <- as.factor(metadata$`treatment:ch1`)
+     
+     # 4. Aggregate using rowsum
+     pseudo_bulk_matrix <- rowsum(t(counts), group_col)
+     pseudo_bulk_matrix <- t(pseudo_bulk_matrix)
+     
+     # 5. Log2 normalize (only if high values found)
+     if(max(pseudo_bulk_matrix, na.rm = TRUE) > 50) {
+         log2_counts <- log2(pseudo_bulk_matrix + 1)
+     } else {
+         log2_counts <- pseudo_bulk_matrix
+     }
+     
+     # 6. Build the final object
+     new_pData <- data.frame(Condition = colnames(log2_counts), row.names = colnames(log2_counts))
+     return(ExpressionSet(assayData = log2_counts, phenoData = AnnotatedDataFrame(new_pData)))
+ }
