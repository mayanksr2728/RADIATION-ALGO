> process_gse <- function(gse_id) {
+     # 1. Download with explicit destdir
+     gse <- getGEO(gse_id, GSEMatrix = TRUE, destdir = download_dir, AnnotGPL = TRUE)[[1]]
+     
+     # 2. Extract metadata
+     pheno <- pData(gse)
+     
+     # 3. Find Dose: Search all columns for numbers before 'Gy'
+     char_data <- apply(pheno, 1, function(x) paste(x, collapse = " "))
+     # Regex: look for numbers preceding 'Gy' or 'gy'
+     dose_matches <- regmatches(char_data, regexec("([0-9.]+)\\s*(Gy|gy)", char_data))
+     doses <- as.numeric(sapply(dose_matches, function(x) if(length(x) > 1) x[2] else NA))
+     
+     # Filter out NA
+     keep <- !is.na(doses)
+     doses <- doses[keep]
+     exprs_data <- exprs(gse)[, keep]
+     
+     # 4. Model
+     design <- model.matrix(~doses)
+     fit <- eBayes(lmFit(exprs_data, design))
+     
+     # 5. Extract results
+     results <- topTable(fit, coef = 2, number = Inf)
+     
+     # Add gene symbols if available in fData
+     if("GENE_SYMBOL" %in% colnames(fData(gse))) {
+         results$GeneSymbol <- fData(gse)$GENE_SYMBOL[match(rownames(results), rownames(fData(gse)))]
